{:id          :isaac.google
 :version     "0.1.15"
 :builtin?    true
 :factory     isaac.google.module/create-module
 :description "Shared Google Workspace plumbing for Isaac — OAuth for the Google user, the Pub/Sub push door and durable inbox, registrations and renewal, health. Knows nothing of Chat or Gmail."

 :berths
 {:isaac.google/scopes
  {:description "OAuth scopes the Google user login requests. Each consumer contributes the scopes it needs; isaac-google unions them (always including openid) when building the authorization URL."
   :schema      {:type :seq
                 :spec {:type :string}}}
  :isaac.google/handler
  {:description "Pub/Sub event handlers keyed on event type (Chat ce-type or gmail/watch). Each contribution is [type handler]."
   :schema      {:type       :map
                 :key-spec   {:type :string}
                 :value-spec {:type    :any
                              :factory isaac.google.handler/register-handler!}}}
  :isaac.google/registration
  {:description "Registrations with Google to create and renew on the shared timer. Each contribution is {:create! :renew! :expiry :key} — plus, for registrations Google cannot list (Gmail watch), :remote (fn [] -> {key {:name :expires-at}}, usually the timer's own persisted state) and :delete! (fn [name])."
   :schema      {:type       :map
                 :key-spec   {:type :keyword}
                 :value-spec {:type    :map
                              :factory isaac.google.registration/register!
                              :schema  {:create! {:type :symbol}
                                        :renew!  {:type :symbol}
                                        :expiry  {:type :symbol}
                                        :key     {:type :symbol}
                                        :remote  {:type :symbol}
                                        :delete! {:type :symbol}}}}}}

 ;; directory.readonly lets isaac.google.people ask the Workspace directory for a
 ;; user's email: Chat never gives one for a human sender (isaac-8s6s).
 ;;
 ;; No Cloud Platform scope belongs here. `auth/pubsub` used to, so the hourly
 ;; heartbeat and `isaac google smoke --send-live` could publish as the
 ;; signed-in user — and a Workspace with "Google Cloud console and SDK session
 ;; control" applies its reauthentication frequency (default 16h) to every app
 ;; requiring a Cloud Platform scope, non-Google apps included. That one scope
 ;; put Gmail, Chat and directory under the same clock and killed yopp's refresh
 ;; token every ~15 hours. Nothing here publishes at all now — a Cloud
 ;; Scheduler job publishes the heartbeat as a Google APIs service account
 ;; inside GCP (isaac-ey6q, isaac-286x, isaac-clly).
 :isaac.google/scopes ["openid"
                       "https://www.googleapis.com/auth/directory.readonly"]

 ;; Who is this person? The agent asks Google with Isaac's own token, rather
 ;; than a crew shelling out to another CLI with its own grant (isaac-jqk2).
 :isaac.agent/tools
 {:google__whois {:factory isaac.google.tools/whois-tool-factory}}

 ;; The Pub/Sub push door's identity is one trust rule per Google organization,
 ;; and a rule's :audience and :email are config refs — static paths, so they
 ;; must name an organization (google.<id>.push.endpoint). The manifest cannot
 ;; know those ids, so isaac.google.component registers the rules at start
 ;; instead. There is no unnamed rule, because there is no unnamed
 ;; organization (isaac-okfj).

 ;; The consent redirect arrives from the operator's own browser with no
 ;; credentials, so the callback route's scope is one isaac.google.door's code
 ;; verifier grants on that path alone — the handshake is proved by the state
 ;; nonce and the PKCE verifier the pending login holds (isaac-2abl).

 :isaac.http/route
 [{:method  :post
   :path    "/google/pubsub"
   :handler isaac.google.http/handler
   :scope   :google/push}
  {:method  :get
   :path    "/google/oauth/callback"
   :handler isaac.google.http/oauth-callback
   :scope   :google/oauth-callback}]

 :isaac/component
 {:google-registration {:namespace isaac.google.component}}

 ;; Nothing here publishes: a Cloud Scheduler job publishes the heartbeat to
 ;; the topic as a Google APIs service account inside GCP, so there is no key
 ;; to name and none for constraints/iam.disableServiceAccountKeyCreation to
 ;; refuse. What is left to get wrong is the interval the watch judges arrival
 ;; against — and a heartbeat configured without one would read as watched and
 ;; never fire, so the loader refuses it instead (isaac-clly, replacing
 ;; isaac-286x's credentials check).
 :isaac.config/check
 {:google-heartbeat {:fn isaac.google.health/check-heartbeat}}

 :isaac/cli
 {:google {:usage     "google <subcommand> [options]"
           :summary   "Google user login and shared Workspace plumbing"
           :namespace isaac.google.cli}}

 :isaac.config/schema
 {:google
 {:schema
  {:name :google,
   :type :map,
   :description
   "Shared Google Workspace plumbing, per Google organization — OAuth, Pub/Sub topic, GCP project. A map of organization id to that organization's config.",
   :key-spec {:type :keyword},
   :value-spec
   {:name :google-tenant,
    :type :map,
    :message
    "must be a map of one Google organization's config — :google is a map of organization id to config, e.g. google.tonotop.oauth.client-id",
    :description "One Google organization Isaac serves.",
    :schema
    {:project
     {:type :string,
      :description "GCP project id that owns the Pub/Sub topic."},
     :topic
     {:type :string,
      :description "Pub/Sub topic path (projects/<id>/topics/<name>)."},
     :renew-within-hours
     {:type :int,
      :description
      "Hours before expiry at which the registration timer renews a subscription. Default 24."},
     :health
     {:name :google-health,
      :type :map,
      :description
      "Health thresholds for one Google organization: how long it may be silent, and the externally-published heartbeat it watches for.",
      :schema
      {:silent-after-hours
       {:type :int,
        :description
        "Hours without any event from Google for this organization before it is silent. Default 6."},
       :heartbeat
       {:name :google-heartbeat,
        :type :map,
        :description
        "Pub/Sub heartbeat: a Cloud Scheduler job publishes one message to this organization's topic on a schedule and Isaac watches for it at the push door. Isaac publishes nothing — naming the interval is what turns the watch on.",
        :schema
        {:expected-interval-ms
         {:type :int,
          :description
          "How often the external publisher (a Cloud Scheduler job on the topic) publishes a heartbeat, in milliseconds. Setting it is what turns the watch on; no heartbeat arriving for this long plus :grace-ms is :heartbeat-missed. No default — only the schedule the publisher runs on can say what late means."},
         :grace-ms
         {:type :int,
          :description
          "Milliseconds of slack past the expected arrival — scheduler jitter plus Pub/Sub delivery — before a heartbeat counts as missed. Default 60000."},
         :enabled
         {:type :boolean,
          :description
          "Retired and ignored; leaving it set is a warning, not a refusal. Naming :expected-interval-ms is what turns the watch on — a switch that could be on over an interval nobody set is the inert watchdog this replaced. Declared here only so a leftover value is reported once, by the heartbeat check, rather than twice."}}}}},
     :oauth
     {:name :google-oauth,
      :type :map,
      :description
      "OAuth client for the Google user (authorization-code flow).",
      :schema
      {:client-id
       {:type :string,
        :validations [:present?],
        :description "OAuth client id from Google Cloud Console."},
       :client-secret
       {:type :string,
        :validations [:present?],
        :description
        "OAuth client secret. Prefer ${GOOGLE_CLIENT_SECRET} from .env — never plaintext."},
       :account
       {:type :string,
        :description
        "Google account the tokens belong to (e.g. yopp@tonotop.com)."},
       :redirect-base
       {:type :string,
        :description
        "Public base URL the login redirects back to, as https://<host>; the callback is <base>/google/oauth/callback and must be an Authorized redirect URI on a Web-application OAuth client. Unset, the login pastes a code (works with a Desktop client)."}}},
     :push
     {:name :google-push,
      :type :map,
      :description "Pub/Sub push door.",
      :schema
      {:endpoint
       {:type :string,
        :description
        "HTTPS URL Google POSTs to (aud of the OIDC token)."},
       :service-account
       {:type :string,
        :description "Push subscription service account email."}}}}}}}}}
